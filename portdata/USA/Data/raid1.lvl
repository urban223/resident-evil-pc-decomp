tbox  1872 -1650  5524   1942 -1280 10748  1 4 975 100
tbox  8228 -1650  5524   8298 -1280 10658  1 4 975 100
# rail cap
tbox  1872 -1800  5454   2310 -1650  5569  1 27 975 100
tbox  3901 -1800  5454   8298 -1650  5569  1 27 975 100
tbox  1872 -1800 10613   8298 -1650 10728  1 27 975 100
tbox  1872 -1800  5569   1987 -1650 10703  1 27 975 100
tbox  8183 -1800  5569   8298 -1650 10613  1 27 975 100

# The doorway: the picture's door is 1180 x 3195 (x 2407..3586) - it was
# guessed 1450 x 2392 before, which skewed its picture - widened to 1400
# (x 2407..3807), in a dark frame.
# The door itself swings (`door`): walk into it and it opens away from you,
# and room 003 is just there behind it - no cut, no loading. The meshes at its
# hinge swing with it: the leaf (flag 512: its picture turns with it) and its
# brass.
door  2407  5477  1400 300
mesh 30  2407     0  5477     0 100 513  5 1400   # the leaf
mesh 31  2407     0  5477     0 100 1    7  300   # its knobs, plates and hinges
tbox  2310 -3320  5454   2407         0  5540   1 4 1300 90
tbox  3807 -3320  5454   3901         0  5540   1 4 1300 90
tbox  2310 -3320  5454   3901 -3195  5540   1 4 1300 90

# The mirror over the basin: a real one. The glass is the hole above; the
# game reflects the characters in it (its own mirror pass, armed as SCD
# opcode 0x0F arms it) and the arena reflects the room.
mirror 1 8290  6140 6980  -3130 -2080
mesh 27  8298     0  6560     0 100 1   4  500   # its wooden frame

# The low cistern box behind the pan.
tbox  6680 -1740 10160   7880   -900 10728   1 26 1200 100   # its body
tbox  6650 -1800 10130   7910 -1740 10728   1 19 1260 110   # its lid, overhanging


# The two worn mats.
tbox  2410       -8  7370   4790         0  8540   1 10 2380 100
tbox  6766       -8  8524   7767         0  9711   1 15  950 100

# The fittings: id x y z yaw scale flags tex tile (tools/build_raid_meshes.py).
# Flags 129 = drawn and casting a shadow from the lights (on the floor and walls).
mesh 1   3765     0  9840     0 100 129  18  900   # the bath, outside
mesh 11  3765     0  9840     0 100 1   3 1200   # ... its rim and hollow
mesh 16  4050     0  9015     0 100 129  21  600   # the towel over its rim
mesh 9   2320     0 10000     0 100 1   7  300   # its mixer: two valves and a short spout
mesh 25  2320     0 10000     0 100 1  23  400   # ... the hand shower, into the bath
mesh 13  3265     0 10590     0 100 129   3  900   # the trough over it
mesh 14  2909 -2010 10560     0 100 1  28  250   # ... a brown glass jar in it
mesh 18  3527 -2010 10610     0 100 1  23  300   # ... and a safety razor
mesh 15  2072     0  9879     0 100 129   3  700   # the tray at its head
mesh 17  2009 -2165  9582  3072 100 1  11  300   # ... a crumpled rubber glove in it
mesh 2   7400     0  9530     0 100 129   3  900   # the pan
mesh 3   7400     0  9530     0 100 1  20  900   # its lid
mesh 28  7400     0  9530     0 100 1  23  300   # ... its chrome hinges and edge
mesh 29  6560  -150 10728     0 100 1  23  300   # the stop valve by the cistern
mesh 4   7280     0 10445     0 100 1   7  300   # the cistern's lever and pipe
mesh 19  8298 -1400  9570  1024 100 1  23  300   # the paper holder
mesh 20  8298 -1400  9570  1024 100 1   9  300   # ... and its roll
mesh 5   7840     0  6470     0 100 129   3  900   # the basin
mesh 10  8298     0  6470     0 100 1  23  400   # its taps and waste
mesh 6   8148     0  6560     0 100 129   3  700   # the shelf, centred under the mirror
mesh 12  8160 -1976  6207     0 100 1  24  400   # ... a bottle on it
mesh 7   6602     0  5700     0 100 1   4  600   # the towel horse, leaning on the wall
mesh 8   6602     0  5700     0 100 1   6  600   # ... and its towel

