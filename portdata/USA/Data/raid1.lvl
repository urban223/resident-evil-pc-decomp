tbox  1430 -4000  3012   1730     0  5154  65 1 1600 100    # low X, the corridor's end
tbox  8598 -4000  5154   9290     0 11562  67 1 1600 100    # the bathroom's back, from the bedroom
tbox  1430 -4000  5154   1572     0  5454  65 1 1600 100
