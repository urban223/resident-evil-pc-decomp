tbox  3901 -1280  5454   8298   -470  5462  1 16 1760 100
tbox  1872 -1280 10720   8298  -470 10728  1 16 1760 100
tbox  1872 -1280  5462   1880   -470 10810  1 16 1760 100
tbox  8290 -1280  5462   8298   -470 10720  1 16 1760 100
# rail
tbox  1872 -1650  5454   2310 -1280  5524  1 4 975 100
