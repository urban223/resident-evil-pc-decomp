tools/__pycache__/*

# assets/ is the PLAYER'S OWN COPY OF THE GAME - Capcom's data, supplied by
# whoever cloned this, never redistributed here. Everything this port itself
# produced lives in portdata/ instead, which IS tracked; tools/deploy_portdata.py
# copies it into assets/ and both bin/ trees. See docs/ASSETS.md.
assets/
.kilo/
.vs/
bin/
obj/
build/
# Self-contained Linux bundles from tools/package_linux.sh.
dist/
*.BMP
*.jpg
*.png
*.log
# Runtime state (P8): config.ini is created by the game and rewritten on exit,
# so it is no longer tracked; re1.lock is the single-instance guard.
config.ini
re1.lock
# portdata/ is tracked on purpose - never let the broad *.png / *.jpg rules
# above swallow an asset that belongs in it.
!portdata/**

# Python bytecode from running the test scripts.
tests/__pycache__/
